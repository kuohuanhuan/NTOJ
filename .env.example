# Required. Use long random values, e.g. `openssl rand -hex 24`.
DB_PASSWORD=

# First administrator, created on startup while no administrator exists.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Shared secret for judge workers (at least 32 characters). Leave empty to disable the judge API.
JUDGE_TOKEN=

SITE_TITLE=NTOJ
HTTP_PORT=8080
# Keep true behind HTTPS. Set to false only for plain-HTTP local testing.
COOKIE_SECURE=true
ALLOW_SIGNUP=true
# Seconds between two submissions of one account outside contests.
SUBMIT_COOLDOWN=5
